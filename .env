# Copy to .env and edit. Never committed.
# Every secret is required in code — nothing falls back to a value that
# would also live in this repo.

# --- Operations panel (VAE-01) ---------------------------------------------
# Signing key for session tokens (min 32 chars, HMAC-SHA256).
VAE_JWT_SECRET=demo-signing-secret-at-least-32-characters-long
# Session lifetime, in minutes.
VAE_SESSION_MINUTES=480
# Seconds between accessibility re-probes of the sources.
VAE_SOURCE_STREAM_SECONDS=3

# --- Directory service (EXT-IF-06) -----------------------------------------
LDAP_URL=ldap://openldap:389
LDAP_BIND_DN_TEMPLATE=uid={username},ou=people,dc=saag,dc=local
LDAP_GROUP_SEARCH_BASE=ou=groups,dc=saag,dc=local
# Read-only account the group search binds as.
LDAP_SERVICE_BIND_DN=cn=admin,dc=saag,dc=local
LDAP_SERVICE_PASSWORD=saag-standin-admin
# Directory group -> authorization mapping.
LDAP_GROUP_AUTHORIZATIONS=view=saag-viewers,configure_sources=saag-operators,produce_model_setup_data=saag-operators

# --- Model Setup Data Generation (MSD) -------------------------------------
# Encrypts stored data-source credentials at rest.
MSD_CREDENTIAL_ENCRYPTION_KEY=demo-credential-encryption-key
# Where transferred source files are copied to.
MSD_WORKSPACE_DIR=/var/lib/saag/workspace
# Rules file for classification and extraction. Defaults to the one shipped
# in the package.
# MSD_RULES_FILE=/etc/saag/rules.json

# --- Storage ---------------------------------------------------------------
POSTGRES_USER=saag
POSTGRES_PASSWORD=saag
POSTGRES_DB=saag
DATABASE_URL=postgresql+psycopg://saag:saag@postgres:5432/saag

# --- Web (Operations Panel UI) ----------------------------------------------
# Reachable from the operator's browser, not just the Docker network.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Origins allowed to call the API (comma-separated).
WEB_ALLOWED_ORIGINS=http://localhost:3000
